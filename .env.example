# ==============================================================================
# Autonomous Inbound Call Admin Agent - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in the appropriate credentials:
#   cp .env.example .env
# Never commit .env to version control.
# ==============================================================================

# --- n8n Service Configuration ---
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http

# Public Webhook URL:
# - Local Dev (Ngrok): https://<your-ngrok-subdomain>.ngrok-free.app/
# - Production (VPS):  https://n8n.yourcompany.com/
WEBHOOK_URL=http://localhost:5678/

# Shared secret key passed in HTTP header "X-Webhook-Secret" by ElevenLabs
WEBHOOK_SECRET=generate_a_random_32_character_secret_here

# Business Profile & Timezone
# NOTE: These are synced from config/business-profile.yaml by scripts/render_config.py.
# Edit the profile and run the render script rather than hand-editing here.
BUSINESS_NAME=Acme Auto Care & Front Desk
BUSINESS_TIMEZONE=America/New_York
GENERIC_TIMEZONE=America/New_York

# Bookable appointment start times (comma-separated) and calendar query window.
APPOINTMENT_SLOTS=09:00 AM,10:30 AM,01:00 PM,02:30 PM,04:00 PM
BUSINESS_HOURS_START=09:00
BUSINESS_HOURS_END=17:00

# --- Telephony Integration (Option A: Zadarma SIP Trunk [Recommended] | Option B: Twilio) ---
# Option A: Zadarma SIP Trunk (https://zadarma.com)
ZADARMA_SIP_SERVER=pbx.zadarma.com
ZADARMA_SIP_LOGIN=123456-100
ZADARMA_SIP_PASSWORD=your_zadarma_sip_password
ZADARMA_PHONE_NUMBER=+15551234567

# Option B: Twilio Telephony (https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+15551234567

# --- ElevenLabs Conversational AI Voice Engine ---
# API Key from https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_AGENT_ID=your_elevenlabs_conversational_agent_id_here

# --- Supabase Cloud Database (Free Tier) ---
# Project credentials from https://supabase.com/dashboard/project/<ref>/settings/api
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# --- Google Calendar Integration ---
# Google Cloud Console OAuth 2.0 Credentials:
# Authorized redirect URI: https://<WEBHOOK_URL>/rest/oauth2-credential/callback
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
# Target calendar ID ('primary' or specific calendar email)
GOOGLE_CALENDAR_ID=primary
